{
  "cli": { "version": ">= 24.8.0", "appVersionSource": "local" },
  "build": {
    "base": { "node": "24.3.0", "pnpm": "11.5.0" },
    "development": {
      "extends": "base",
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "extends": "base",
      "environment": "preview",
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "android-qa": {
      "extends": "base",
      "environment": "preview",
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_AQUABLOOM_QA": "1" },
      "android": {
        "withoutCredentials": true,
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=x86_64"
      }
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "android": { "buildType": "app-bundle" }
    }
  }
}
