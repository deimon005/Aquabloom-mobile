    "export:android": "expo export --platform android --max-workers 2",
    "doctor": "pnpm dlx expo-doctor",
    "api:generate": "node scripts/generate-api.mjs",
    "api:setup": "pnpm --dir tools/openapi install --frozen-lockfile",
    "test:architecture": "node --test scripts/architecture.test.mjs"
